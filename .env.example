# Required: create a unique value with Django's `get_random_secret_key()`.
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret

# Local development defaults. Never enable DEBUG in a public deployment.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins, for example: https://example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Filesystem path to the separately distributed five-class ResNet-50 checkpoint.
DR_MODEL_PATH=/absolute/path/to/DDRresnet50_best_acc_final.pth
